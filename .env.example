# Application : pooler Supabase en mode SESSION (port 5432), connexions réutilisées.
# Mesuré : ~80 ms par requête, contre 500–1000 ms en mode transaction (6543 + pgbouncer=true).
# Sur Vercel, surveiller le nombre de connexions (limite du pooler) ; ajuster connection_limit.
DATABASE_URL="postgresql://postgres.xxx:your-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=20"

# Migrations : pooler en mode session (5432), compatible IPv4.
DIRECT_URL="postgresql://postgres.xxx:your-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase (clé publique uniquement : aucune clé secrète n'est nécessaire à l'application)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base « shadow » pour `npm run db:migrate` (second projet Supabase, JAMAIS la production)
SHADOW_DATABASE_URL=""

# Base de test pour `npm run test:db` : projet Supabase dédié, connexion directe (5432).
# ATTENTION : elle est entièrement réinitialisée à chaque exécution des tests.
TEST_DATABASE_URL=""
