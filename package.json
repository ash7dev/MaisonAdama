{
  "name": "maison-adama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev",
    "build": "npx prisma generate && npx next build",
    "start": "npx next start",
    "lint": "npx next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --create-only && node prisma/guard-migrations.mjs",
    "db:deploy": "node prisma/guard-migrations.mjs && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:guard": "node prisma/guard-migrations.mjs",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:db": "vitest run --project db"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.1",
    "baseline-browser-mapping": "^2.4.0",
    "lucide-react": "^0.479.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
